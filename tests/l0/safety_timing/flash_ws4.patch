+/**
+ * @brief Set the flash wait states from the current STM32G4 reference manual.
+ *
+ * Zephyr's clock driver calls LL_SetFlashLatency() from STM32CubeG4 LL
+ * v1.5.1, whose table (20 MHz per wait state) follows an early RM0440
+ * revision: 8 wait states at 170 MHz. RM0440 Table 9 now gives 34 MHz per
+ * wait state in Range 1 boost mode and 30 MHz in Range 1 normal mode, so
+ * 4 wait states at 170 MHz. Every flash access the caches miss then costs
+ * 5 CPU cycles instead of 9 (measured with L0-TIM-01/02, Core2
+ * docs/testing/worklog.md, 2026-11-12).
+ *
+ * Runs after the clock driver (PRE_KERNEL_1, priority 1). Only lowers the
+ * latency, only with HCLK = SYSCLK in Range 1; otherwise keeps the driver's
+ * value.
+ *
+ * @return Always returns 0 (success).
+ */
+static int _flash_latency_init()
+{
+#if defined(CONFIG_SOC_SERIES_STM32G4X)
+	if (LL_PWR_GetRegulVoltageScaling() != LL_PWR_REGU_VOLTAGE_SCALE1 ||
+	    LL_RCC_GetAHBPrescaler() != LL_RCC_SYSCLK_DIV_1)
+	{
+		return 0;
+	}
+	const uint32_t hclk = sys_clock_hw_cycles_per_sec();
+	const uint32_t step = LL_PWR_IsEnabledRange1BoostMode() ? 34000000U : 30000000U;
+	const uint32_t limit = LL_PWR_IsEnabledRange1BoostMode() ? 170000000U : 150000000U;
+	if (hclk == 0U || hclk > limit)
+	{
+		return 0;
+	}
+	const uint32_t wait_states = (hclk - 1U) / step;  /* 0 WS up to one step, 1 WS up to two, ... */
+	if (wait_states < LL_FLASH_GetLatency())
+	{
+		LL_FLASH_SetLatency(wait_states);
+		while (LL_FLASH_GetLatency() != wait_states)
+		{
+		}
+	}
+#endif /* CONFIG_SOC_SERIES_STM32G4X */
+	return 0;
+}
+
 /**
