/**
 * Micro-verter on the Twist 1.4.2 configuration.
 *
 * Measurements are split by converter, one ADC each, each ADC triggered
 * by a leg of its own converter:
 *
 *   ADC_1, boost side, triggered by LEG1 (TIMA, 200 kHz, synchronised with
 *   the boost leg LEG2 through the master):
 *     order 0  I1_LOW  PA1 (Spin 30)  I_ILow1, boost phase 1 current
 *     order 1  I2_LOW  PC1 (Spin 25)  I_ILow2, boost phase 2 current
 *     order 2  V1_LOW  PA0 (Spin 29)  V_ILow,  boost input voltage
 *     order 3  V_HIGH  PC3 (Spin 27)  V_DCBus, DC bus voltage
 *
 *   ADC_2, inverter side, triggered by LEG3 (TIMD, 50 kHz):
 *     order 0  I_HIGH  PC2 (Spin 26)  I_AC, grid current
 *     order 1  V2_LOW  PC0 (Spin 24)  V_AC, grid voltage
 *
 * The sensor names stay the Twist ones (used by main.cpp). Currents come
 * first: order 0 is converted right at the trigger.
 *
 * The trigger instant is CMP3 of the leg, 0 unless setTriggerValue() is
 * called: the valley of the up-down counter, i.e. the middle of the
 * high-side pulse, where the inductor current equals its average. To
 * check on the scope for LEG3.
 */

&leg1 {
    default-adc = "ADC_1";
};

&leg2 {
    driver-pin-num = <19>;
    /* ADC_2 is triggered by LEG3: the HRTIM ADC trigger source is
     * overwritten by the last leg initialized, so only one leg per ADC */
    default-adc = "UNKNOWN_ADC";
};

/**
 * Inverter H-bridge (schematic page 9/9, pin labels; the PWM channel
 * table of that page is wrong for CHE1 / CHE2):
 *   LEG3 = TIMD: PB14 (Spin 5) PWM_IIHigh1, PB15 (Spin 6) PWM_IILow1
 *   LEG4 = TIME: PC8 (Spin 10) PWM_IIHigh2, PC9 (Spin 11) PWM_IILow2
 *
 * 50 kHz center-aligned, independent of the 200 kHz boost legs
 * (leg-frequency must be >= min-frequency = 50 kHz of the Twist 1.4.2).
 *
 * To check before powering:
 * - dead time: 100 ns is copied from the Twist legs, not computed for the
 *   inverter switches, drivers and isolators;
 * - bridge supply: DIS_HV (PB9, Spin 21) drives the EN pin of U703
 *   (VPS8701B), which makes the isolated +12V_HV of the inverter drivers
 *   and isolators. Not handled yet (EN polarity to confirm); no
 *   driver-pin-num here (PC12 / Spin 19 is EN_I, the boost side, on LEG2).
 */
&powershield {
    leg3: leg3 {
        leg-name = "LEG3";
        pwms = <&pwmd 1 0>, <&pwmd 2 0>;
        pwm-pin-num = <5 6>;
        /* HRTIM ADC trigger 3 on timer D compare 3 */
        default-adc = "ADC_2";
        default-adc-decim = <1>;
        default-edge-trigger = "EdgeTrigger_up";
        default-dead-time = <100 100>;
        default-modulation = "UpDwn";
        default-phase-shift = <0>;
        leg-frequency = <50000>;
        status = "okay";
    };

    leg4: leg4 {
        leg-name = "LEG4";
        pwms = <&pwme 1 0>, <&pwme 2 0>;
        pwm-pin-num = <10 11>;
        default-adc = "UNKNOWN_ADC";
        default-adc-decim = <1>;
        default-edge-trigger = "EdgeTrigger_up";
        default-dead-time = <100 100>;
        default-modulation = "UpDwn";
        default-phase-shift = <0>;
        leg-frequency = <50000>;
        status = "okay";
    };
};

/* ---------------- ADC_1: boost side ---------------- */

&i1low {
    default-adc = "ADC_1";
    default-order = <0>;
};

&i2low {
    default-adc = "ADC_1";
    default-order = <1>;
};

&v1low {
    default-adc = "ADC_1";
    default-order = <2>;
};

&vhigh {
    default-adc = "ADC_1";
    default-order = <3>;
};

/* ---------------- ADC_2: inverter side ---------------- */

&ihigh {
    default-adc = "ADC_2";
    default-order = <0>;
};

&v2low {
    default-adc = "ADC_2";
    default-order = <1>;
};
