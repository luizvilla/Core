

&leg2{
    driver-pin-num = <19>;
};

/**
 * Inverter H-bridge (schematic page 9/9, pin labels; the PWM channel
 * table of that page is wrong for CHE1 / CHE2):
 *   LEG3 = TIMD: PB14 (Spin 5) PWM_IIHigh1, PB15 (Spin 6) PWM_IILow1
 *   LEG4 = TIME: PC8 (Spin 10) PWM_IIHigh2, PC9 (Spin 11) PWM_IILow2
 *
 * 50 kHz center-aligned, independent of the 200 kHz boost legs
 * (leg-frequency must be >= min-frequency = 50 kHz of the Twist 1.4.2).
 *
 * To check before powering:
 * - dead time: 100 ns is copied from the Twist legs, not computed for the
 *   inverter switches, drivers and isolators;
 * - bridge supply: DIS_HV (PB9, Spin 21) drives the EN pin of U703
 *   (VPS8701B), which makes the isolated +12V_HV of the inverter drivers
 *   and isolators. Not handled yet (EN polarity to confirm); no
 *   driver-pin-num here (PC12 / Spin 19 is EN_I, the boost side, on LEG2);
 * - ADC: no trigger. ADC_2 (V2_LOW = V_AC, I2_LOW, I_HIGH = I_AC by
 *   default) is triggered by LEG2. It could be triggered by LEG3 instead
 *   (HRTIM ADC trigger 3 on timer D compare 3), to sample I_AC at the
 *   centre of the inverter pulses, at the cost of I2_LOW.
 */
&powershield {
    leg3: leg3 {
        leg-name = "LEG3";
        pwms = <&pwmd 1 0>, <&pwmd 2 0>;
        pwm-pin-num = <5 6>;
        default-adc = "UNKNOWN_ADC";
        default-adc-decim = <1>;
        default-edge-trigger = "EdgeTrigger_up";
        default-dead-time = <100 100>;
        default-modulation = "UpDwn";
        default-phase-shift = <0>;
        leg-frequency = <50000>;
        status = "okay";
    };

    leg4: leg4 {
        leg-name = "LEG4";
        pwms = <&pwme 1 0>, <&pwme 2 0>;
        pwm-pin-num = <10 11>;
        default-adc = "UNKNOWN_ADC";
        default-adc-decim = <1>;
        default-edge-trigger = "EdgeTrigger_up";
        default-dead-time = <100 100>;
        default-modulation = "UpDwn";
        default-phase-shift = <0>;
        leg-frequency = <50000>;
        status = "okay";
    };
};


